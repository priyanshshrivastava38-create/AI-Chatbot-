# =============================================================================
# Prism — environment template
#
# Copy to `.env` and fill in. Every variable below is read by the running app;
# the names and defaults come from src/lib/env.ts (validated with zod),
# src/lib/auth.ts, src/lib/db.ts, src/lib/ai/provider.ts and prisma/seed.ts.
#
# Rules enforced by src/lib/env.ts (getEnv()) at first use:
#   - A missing/invalid value throws EnvConfigError, which API routes report as
#     HTTP 500 { code: "server_misconfigured" }. There are no silent fallbacks.
#   - Values with a default below may be left unset entirely.
#   - Do NOT commit a real .env; note .gitignore's `.env*` pattern also matches
#     this file, so keep it in the repo with `git add -f .env.example`.
#
# NEVER put a real secret in this file — placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Optional. Must be exactly one of: development | test | production.
# Defaults to "development" when unset. `next dev` / `next build` set this
# themselves, so leave it commented out unless you run outside the Next CLI.
# NODE_ENV=production

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string. Used twice:
#   1. by the app at runtime — src/lib/db.ts builds a PrismaPg driver adapter
#      (@prisma/adapter-pg), so Prisma 7 talks to Postgres through `pg`.
#   2. by the Prisma CLI — prisma7.config.ts reads process.env.DATABASE_URL
#      after `import "dotenv/config"`, so `prisma migrate deploy` needs this in
#      the process env or in a local .env file.
#
# Local example:
DATABASE_URL=postgresql://postgres:***@localhost:5432/prism?schema=public
#
# Managed Postgres (Neon / Supabase / Vercel Postgres / RDS) usually requires
# SSL. Keep `sslmode=require` and, for pooled connections, use the pooler port:
# DATABASE_URL=postgresql://user:***@ep-x-pooler.region.aws.neon.tech/dbname?sslmode=require

# REQUIRED. Session JWT signing key, minimum 16 characters (enforced by env.ts).
# Generate one and keep it out of git — `npx auth secret` prints and can write
# it to .env; openssl works too:
#   openssl rand -base64 32
AUTH_SECRET=replac…ters

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------

# Optional. openai | ollama. Defaults to "openai".
# Both use the same OpenAI-compatible client (src/lib/ai/provider.ts); the value
# only changes the fallback base URL, the fallback model, the API-key
# requirement, and whether `stream_options.include_usage` is sent.
AI_PROVIDER=openai

# Optional. OpenAI-compatible base URL. When unset:
#   AI_PROVIDER=ollama -> http://127.0.0.1:11434/v1
#   AI_PROVIDER=openai -> https://api.openai.com/v1
# Must parse as a URL (z.url()), so include the scheme and no trailing junk.
OPENAI_BASE_URL=https://api.openai.com/v1

# REQUIRED when AI_PROVIDER=openai (env.ts throws EnvConfigError otherwise).
# Ignored for ollama — a placeholder ("not-required") is used instead.
# Any OpenAI-compatible gateway works (OpenRouter, vLLM, LM Studio, Azure proxy).
OPENAI_API_KEY=sk-pla…xxxx

# Optional. Passed to the OpenAI SDK `organization` option only when non-empty
# (read straight from process.env in src/lib/ai/provider.ts). Leave unset if you
# are not in an org with multiple projects.
# OPENAI_ORG_ID=

# Optional. Model used when the user, the conversation and the allowlist do not
# pick one. Defaults: ollama -> "qwen2.5:3b", openai -> "gpt-4o-mini".
AI_DEFAULT_MODEL=gpt-4o-mini

# Optional. Comma-separated hard allowlist of model ids. Unset or empty allows
# every model the provider lists. A model outside this list is rejected
# (400 model_not_allowed on PATCH /api/preferences and conversations/[id]) or
# silently falls back to the default on a chat turn. It also filters
# GET /api/models.
# AI_MODEL_ALLOWLIST=gpt-4o-mini,gpt-4o

# Optional. Upstream request timeout in milliseconds (positive int). Default 120000.
# AI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------

# Optional. Max characters per chat message (positive int). Default 16000.
# Enforced by the chat request schema and echoed to the client via /api/models.
MAX_INPUT_CHARS=16000

# Optional. Max upload size in BYTES (positive int). Default 5242880 (5 MB).
# Serverless hosts cap request bodies below this (Vercel is ~4.5 MB) — lower it
# there, or uploads will fail before the app sees them.
MAX_UPLOAD_BYTES=5242880

# Optional. Chat + regenerate requests per user per minute. Default 20.
# Key: `chat:<userId>`, evaluated before the request body is parsed.
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional. Per-minute ceiling for every other API route that does not pass its
# own limit (conversations, and the default for the API guard). Default 120.
# Scopes that override it in code: models 30, export 30, preferences 60,
# usage 60, upload 20.
API_RATE_LIMIT_PER_MINUTE=120

# Optional. Directory for uploaded files, resolved against process.cwd()
# (uploadsRoot() in src/lib/uploads.ts). Default "uploads" -> ./uploads/<userId>/<uuid>.<ext>.
# Use an absolute path that points at a persistent volume in production.
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Seed script only (npm run db:seed -> prisma/seed.ts)
# -----------------------------------------------------------------------------
# Not read by the app. Defaults shown; the seed upserts this demo user with a
# bcrypt(12) hash and one "Welcome" conversation. Change or remove the account
# before exposing a seeded database publicly.
# SEED_EMAIL=demo@example.com
# SEED_PASSWORD=***

# -----------------------------------------------------------------------------
# Auth.js v5 (read by next-auth itself, not by src/lib code)
# -----------------------------------------------------------------------------
# src/lib/auth.ts uses the JWT strategy with the credentials provider and does
# NOT set `trustHost`, and no AUTH_URL is read by our code. Behind a proxy or on
# any non-Vercel host, Auth.js needs help resolving its own callback URL:
# AUTH_URL=https://prism.example.com        # explicit public origin
# AUTH_TRUST_HOST=TRUE                      # or trust X-Forwarded-Host
# Session lifetime is fixed in code at 30 days (AUTH_SESSION_MAX_AGE_SECONDS),
# so there is no env var for it.
# AUTH_URL=
# AUTH_TRUST_HOST=TRUE

# -----------------------------------------------------------------------------
# Local Ollama example — the whole file reduced to five lines
# -----------------------------------------------------------------------------
#   DATABASE_URL=postgresql://postgres:***@localhost:5432/prism?schema=public
#   AUTH_SECRET=***            # openssl rand -base64 32
#   AI_PROVIDER=ollama
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_DEFAULT_MODEL=qwen2.5:3b
# OPENAI_API_KEY is not needed; Ollama ignores it (the app sends "not-required").
# `ollama pull qwen2.5:3b` first, and `ollama serve` must be listening on 11434.
